# ---------------------------------------------------------------------------
# Expense Tracker - backend environment example
# Copy this file to `backend/.env` and fill in REAL values.
# Never commit `backend/.env`. Never put these values in frontend code.
# ---------------------------------------------------------------------------

# --- Application ---
APP_NAME="Expense Tracker API"
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# --- CORS (comma-separated browser origins) ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database (Supabase PostgreSQL in deployed environments) ---
# Pooled connection string: used by the running API (port 6543).
DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# Direct connection string: used by Alembic migrations (port 5432).
MIGRATION_DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Local development alternative (no Supabase required):
# DATABASE_URL=postgresql+psycopg://postgres@127.0.0.1:5432/expense_tracker
# MIGRATION_DATABASE_URL=postgresql+psycopg://postgres@127.0.0.1:5432/expense_tracker

# --- Automated tests (a separate database, never development data) ---
TEST_DATABASE_URL=postgresql+psycopg://postgres@127.0.0.1:5432/expense_tracker_test

# --- Supabase Auth (JWT verification) ---
# Preferred: asymmetric keys via JWKS. Leave SUPABASE_JWT_SECRET empty.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_JWKS_URL=https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_AUD=authenticated
# Legacy projects only: the project's JWT secret (HS256). Keep empty otherwise.
SUPABASE_JWT_SECRET=

# --- Supabase Storage (private receipts bucket) ---
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
SUPABASE_RECEIPTS_BUCKET=receipts
SIGNED_URL_TTL_SECONDS=300
# Only used when Supabase Storage is not configured (local development).
RECEIPT_SIGNING_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
LOCAL_RECEIPTS_DIR=var/receipts

# --- Defaults applied to new users ---
DEFAULT_CURRENCY=NGN
DEFAULT_TIMEZONE=Africa/Lagos

# --- Rate limiting ---
RATE_LIMIT_DEFAULT=120/minute

# --- Scheduled jobs (Render Cron Job -> POST /api/v1/jobs/run) ---
CRON_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
