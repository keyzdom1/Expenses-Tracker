# ---------------------------------------------------------------------------
# Expense Tracker - frontend environment example
# Copy to `frontend/.env` and fill in REAL values.
#
# ONLY public values belong here. Vite inlines every VITE_* variable into the
# browser bundle, so never put a service-role key, database password or any
# other secret in this file.
# ---------------------------------------------------------------------------

# Backend origin (no /api/v1 suffix - the client adds it)
VITE_API_BASE_URL=http://localhost:8000

# Supabase project (public values from Project Settings -> API)
VITE_SUPABASE_URL=https://rduylgdbxnomlhjqsoqc.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_YzUn7gSX6VA16Lq3sQ5igQ_TeCvBJHc
